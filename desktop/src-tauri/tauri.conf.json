{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StockScanner",
  "version": "1.4.0",
  "identifier": "com.stockscanner.ema",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "StockScanner — EMA Swing System",
        "width": 1800,
        "height": 760,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": ["icons/icon.icns"]
  }
}
